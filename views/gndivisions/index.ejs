<div class="topbar">
  <h2>GN division</h2>
  <a class="button" href="/gndivisions/new">Add GN Division</a>
</div>

<table>
  <tr>
    <th>ID</th>
    <th>DS Division ID</th>
    <th>GN Name</th>
    <th>Action</th>
  </tr>

  <% if (gndivisions && gndivisions.length) { %>
    <% gndivisions.forEach(gndivision => { %>
      <tr>
        <td><%= gndivision.id %></td>
        <td><%= gndivision.ds_division_id %></td>
        <td><%= gndivision.gn_name || '-' %></td>
        <td>
          <a href="/gndivisions/<%= gndivision.id %>">Show</a>
          |
          <a href="/gndivisions/<%= gndivision.id %>/edit">Edit</a>
          |
          <a href="/gndivisions/<%= gndivision.id %>/delete">Delete</a>
        </td>
      </tr>
    <% }) %>
  <% } else { %>
    <tr>
      <td colspan="5">No gndivisions found.</td>
    </tr>
  <% } %>
</table>