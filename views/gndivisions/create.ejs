
<h2>Add GN Division</h2>

<form action="/gndivisions" method="POST" class="card p-4 shadow-sm">
  <div class="mb-3">
    <label class="form-label">DS Division ID</label>
    <input type="text" name="ds_division_id" class="form-control" required>
  </div>
  <div class="mb-3">
    <label class="form-label">GN Name</label>
    <input type="text" name="gn_name" class="form-control" required>
  </div>
  <button type="submit" class="btn btn-success">Save</button>
  <a href="/gndivisions" class="btn btn-secondary">Cancel</a>
</form>
