
<h2>Edit GN Division</h2>

<form action="/gndivisions/<%= gndivision.id %>" method="POST" class="card p-4 shadow-sm">
  <div class="mb-3">
    <label class="form-label">Name</label>
    <input type="text" name="name" class="form-control" value="<%= gndivision.name %>" required>
  </div>
  <button type="submit" class="btn btn-success">Update</button>
  <a href="/gndivisions" class="btn btn-secondary">Cancel</a>
</form>
