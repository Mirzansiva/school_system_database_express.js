<div class="mx-auto max-w-3xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-gray-200 sm:p-8">
    <div class="mb-6">
      <h2 class="text-2xl font-bold text-gray-900">Update Student</h2>
      <p class="mt-1 text-sm text-gray-600">Update the student details below.</p>
    </div>

    <form action="/students/<%= student.id %>" method="POST" class="space-y-6">
      <div>
        <label for="admission_number" class="block text-sm font-medium text-gray-900">Admission Number</label>
        <div class="mt-2">
          <input
            id="admission_number"
            type="text"
            name="admission_number"
            value="<%= student.admission_number %>"
            class="block w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500"
          />
        </div>
      </div>

      <div>
        <label for="first_name" class="block text-sm font-medium text-gray-900">First Name</label>
        <div class="mt-2">
          <input
            id="first_name"
            type="text"
            name="first_name"
            value="<%= student.first_name %>"
            required
            class="block w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500"
          />
        </div>
      </div>

      <div>
        <label for="last_name" class="block text-sm font-medium text-gray-900">Last Name</label>
        <div class="mt-2">
          <input
            id="last_name"
            type="text"
            name="last_name"
            value="<%= student.last_name %>"
            required
            class="block w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500"
          />
        </div>
      </div>

       <div>
        <label for="gender" class="block text-sm font-medium text-gray-900">Gender</label>
        <div class="mt-2">
          <input
            id="gender"
            type="text"
            name="gender"
            value="<%= student.gender %>"
            required
            class="block w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500"
          />
        </div>
      </div>

       <div>
        <label for="date_of_birth" class="block text-sm font-medium text-gray-900">Date of Birth</label>
        <div class="mt-2">
          <input
            id="date_of_birth"
            type="text"
            name="date_of_birth"
            value="<%= student.date_of_birth %>"
            required
            class="block w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500"
          />
        </div>
      </div>

       <div>
        <label for="nic_number" class="block text-sm font-medium text-gray-900">NIC Number</label>
        <div class="mt-2">
          <input
            id="nic_number"
            type="text"
            name="nic_number"
            value="<%= student.nic_number %>"
            required
            class="block w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500"
          />
        </div>
      </div>
       <div>
        <label for="birth_certificate_number" class="block text-sm font-medium text-gray-900">Birth Certificate Number</label>
        <div class="mt-2">
          <input
            id="birth_certificate_number"
            type="text"
            name="birth_certificate_number"
            value="<%= student.birth_certificate_number %>"
            required
            class="block w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500"
          />
        </div>
      </div>
       <div>
        <label for="tele_number" class="block text-sm font-medium text-gray-900">Telephone Number</label>
        <div class="mt-2">
          <input
            id="tele_number"
            type="text"
            name="tele_number"
            value="<%= student.tele_number %>"
            required
            class="block w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500"
          />
        </div>
      </div>
      <div>
        <label for="house_id" class="block text-sm font-medium text-gray-900">House ID</label>
        <div class="mt-2">
          <input
            id="house_id"
            type="text"
            name="house_id"
            value="<%= student.house_id %>"
            required
            class="block w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500"
          />
        </div>
      </div>  
      <div>
        <label for="grade_id" class="block text-sm font-medium text-gray-900">Grade ID</label>
        <div class="mt-2">
          <input
            id="grade_id"
            type="text"
            name="grade_id"
            value="<%= student.grade_id %>"
            required
            class="block w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500"
          />
        </div>
      </div>

       <div>
        <label for="medium" class="block text-sm font-medium text-gray-900">Medium</label>
        <div class="mt-2">
          <input
            id="medium"
            type="text"
            name="medium"
            value="<%= student.medium %>"
            required
            class="block w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500"
          />
        </div>
      </div>
      <div>
        <label for="date_of_admission" class="block text-sm font-medium text-gray-900">Date of Admission</label>
        <div class="mt-2">
          <input
            id="date_of_admission"
            type="text"
            name="date_of_admission"
            value="<%= student.date_of_admission %>"
            required
            class="block w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500"
          />
        </div>
      </div>
          <div>
        <label for="per_address" class="block text-sm font-medium text-gray-900">Permanent Address</label>
        <div class="mt-2">
          <input
            id="per_address"
            type="text"
            name="per_address"
            value="<%= student.per_address %>"
            required
            class="block w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500"
          />
        </div>
      </div>
       <div>
        <label for="family_id" class="block text-sm font-medium text-gray-900">Family ID</label>
        <div class="mt-2">
          <input
            id="family_id"
            type="text"
            name="family_id"
            value="<%= student.family_id %>"
            required
            class="block w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500"
          />
        </div>
      </div>

      <div class="flex justify-end gap-4 pt-4">
        <a
          href="/students"
          class="inline-flex items-center justify-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-sm transition hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2"
        >
          Cancel
        </a>
        <button
          type="submit"
          class="inline-flex items-center justify-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2"
        >
          Save
        </button>
      </div>
    </form>
  </div>
</div>