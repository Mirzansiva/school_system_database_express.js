
<h2>Delete Province</h2>

<div class="card shadow-sm p-4">
  <p>Are you sure you want to delete this province?</p>
  <p><strong>ID:</strong> <%= province.id %></p>
  <p><strong>Name:</strong> <%= province.name %></p>
  <form action="/provinces/<%= province.id %>/delete" method="POST">
    <button type="submit" class="btn btn-danger">Confirm Delete</button>
    <a href="/provinces" class="btn btn-secondary">Cancel</a>
  </form>
</div>
