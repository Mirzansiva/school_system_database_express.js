
<div class="d-flex justify-content-between align-items-center mb-3">
  <h2>Provinces</h2>
  <a href="/provinces/new" class="btn btn-primary">Add Province</a>
</div>

<% if (error) { %>
  <div class="alert alert-danger"><%= error %></div>
<% } %>

<div class="card shadow-sm">
  <div class="card-body">
    <table class="table table-striped mb-0">
      <thead>
        <tr>
          <th>ID</th>
          <th>Name</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% provinces.forEach((province) => { %>
          <tr>
            <td><%= province.id %></td>
            <td><%= province.name %></td>
            <td>
              <a href="/provinces/<%= province.id %>" class="btn btn-sm btn-info">View</a>
              <a href="/provinces/<%= province.id %>/edit" class="btn btn-sm btn-warning">Edit</a>
              <a href="/provinces/<%= province.id %>/delete" class="btn btn-sm btn-danger">Delete</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
