
<div class="d-flex justify-content-between align-items-center mb-3">
  <h2>Families</h2>
  <a href="/families/new" class="btn btn-primary">Add Family</a>
</div>

<div class="card shadow-sm">
  <div class="card-body">
    <table class="table table-striped mb-0">
      <thead>
        <tr><th>ID</th><th>Mobile Number</th><th>Father First Name</th><th>Actions</th></tr>
      </thead>
      <tbody>
        <% families.forEach((item) => { %>
          <tr>
            <td><%= item.id %></td>
            <td><%= item.mobile_number %></td>
            <td><%= item.fa_first_name %></td>
            <td>
              <a href="/families/<%= item.id %>" class="btn btn-sm btn-info">View</a>
              <a href="/families/<%= item.id %>/edit" class="btn btn-sm btn-warning">Edit</a>
              <a href="/families/<%= item.id %>/delete" class="btn btn-sm btn-danger">Delete</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
