
<h2>Delete Family</h2>

<div class="card shadow-sm p-4">
  <p>Are you sure you want to delete this family?</p>
  <p><strong>ID:</strong> <%= family.id %></p>
  <p><strong>Mobile Number:</strong> <%= family.mobile_number %></p>
  <p><strong>Father First Name:</strong> <%= family.fa_first_name %></p>
  <form action="/families/<%= family.id %>/delete" method="POST">
    <button type="submit" class="btn btn-danger">Confirm Delete</button>
    <a href="/families" class="btn btn-secondary">Cancel</a>
  </form>
</div>