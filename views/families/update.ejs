
<h2>Edit Family</h2>

<form action="/families/<%= family.id %>" method="POST" class="card p-4 shadow-sm">
  <div class="mb-3">
    <label class="form-label">Mobile Number</label>
    <input type="text" name="mobile_number" class="form-control" value="<%= family.mobile_number %>" required>
  </div>
  <div class="mb-3">
    <label class="form-label">Father First Name</label>
    <input type="text" name="fa_first_name" class="form-control" value="<%= family.fa_first_name %>" required>
  </div>
  <button type="submit" class="btn btn-success">Update</button>
  <a href="/families" class="btn btn-secondary">Cancel</a>
</form>
