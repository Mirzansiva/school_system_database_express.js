<div class="mx-auto max-w-2xl rounded-lg border border-slate-200 bg-white shadow-md">
  <div class="border-b border-slate-200 px-6 py-4">
    <h1 class="text-2xl font-bold text-slate-900">Create Teacher</h1>
    <p class="mt-1 text-sm text-slate-600">Add a new teacher to the system</p>
  </div>

  <form action="/teachers" method="POST" class="p-6">
    <div class="space-y-6">
      <!-- GN Code -->
      <div>
        <label for="registration_number" class="block text-sm font-semibold text-slate-900">Registration Number</label>
        <input
          id="registration_number"
          type="text"
          name="registration_number"
          autocomplete="off"
          class="mt-2 block w-full rounded-lg border border-slate-300 bg-white px-4 py-2 text-slate-900 placeholder:text-slate-400 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
        />
      </div>

      <!-- Village -->
      <div>
        <label for="nic_number" class="block text-sm font-semibold text-slate-900">NIC Number</label>
        <input
          id="nic_number"
          type="text"
          name="nic_number"
          autocomplete="given-name"
          class="mt-2 block w-full rounded-lg border border-slate-300 bg-white px-4 py-2 text-slate-900 placeholder:text-slate-400 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
        />
      </div>

      <!-- Population -->
      <div>
        <label for="first_name" class="block text-sm font-semibold text-slate-900">First Name</label>
        <input
          id="first_name"
          type="text"
          name="first_name"
          autocomplete="given-name"
          class="mt-2 block w-full rounded-lg border border-slate-300 bg-white px-4 py-2 text-slate-900 placeholder:text-slate-400 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
        />
      </div>

        <div>
        <label for="last_name" class="block text-sm font-semibold text-slate-900">Last Name</label>
        <input
          id="last_name"
          type="text"
          name="last_name"
          autocomplete="family-name"
          class="mt-2 block w-full rounded-lg border border-slate-300 bg-white px-4 py-2 text-slate-900 placeholder:text-slate-400 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
        />
      </div>

    <div>
        <label for="gender" class="block text-sm font-semibold text-slate-900">Gender</label>
        <input
          id="gender"
          type="text"
          name="gender"
          autocomplete="given-name"
          class="mt-2 block w-full rounded-lg border border-slate-300 bg-white px-4 py-2 text-slate-900 placeholder:text-slate-400 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
        />
      </div>
              <div>
        <label for="title" class="block text-sm font-semibold text-slate-900">Title</label>
        <input
          id="title"
          type="text"
          name="title"
          autocomplete="given-name"
          class="mt-2 block w-full rounded-lg border border-slate-300 bg-white px-4 py-2 text-slate-900 placeholder:text-slate-400 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
        />
      </div>
              <div>
        <label for="date_of_birth" class="block text-sm font-semibold text-slate-900">Date of Birth</label>
        <input
          id="date_of_birth"
          type="text"
          name="date_of_birth"
          autocomplete="given-name"
          class="mt-2 block w-full rounded-lg border border-slate-300 bg-white px-4 py-2 text-slate-900 placeholder:text-slate-400 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
        />
    </div>

        <div>
        <label for="permanent_address" class="block text-sm font-semibold text-slate-900">Permanent Address</label>
        <input
          id="permanent_address"
          type="text"
          name="permanent_address"
          autocomplete="given-name"
          class="mt-2 block w-full rounded-lg border border-slate-300 bg-white px-4 py-2 text-slate-900 placeholder:text-slate-400 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
        />
      </div>

        <div>
        <label for="mobile_number" class="block text-sm font-semibold text-slate-900">Mobile Number</label>
        <input
          id="mobile_number"
          type="text"
          name="mobile_number"
          autocomplete="given-name"
          class="mt-2 block w-full rounded-lg border border-slate-300 bg-white px-4 py-2 text-slate-900 placeholder:text-slate-400 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
        />
      </div>

              <div>
        <label for="date_of_first_appointment" class="block text-sm font-semibold text-slate-900">Date of First Appointment</label>
        <input
          id="date_of_first_appointment"
          type="text"
          name="date_of_first_appointment"
          autocomplete="given-name"
          class="mt-2 block w-full rounded-lg border border-slate-300 bg-white px-4 py-2 text-slate-900 placeholder:text-slate-400 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
        />
      </div>

    <!-- Action Buttons -->
    <div class="mt-8 flex items-center justify-end gap-4">
      <a href="/teachers" class="inline-flex items-center justify-center rounded-lg border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-900 hover:bg-slate-50">
        Cancel
      </a>
      <button
        type="submit"
        class="inline-flex items-center justify-center rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500"
      >
        Save
      </button>
    </div>
  </form>
</div>