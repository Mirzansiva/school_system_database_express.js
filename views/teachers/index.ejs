<div class="topbar">
    <h2>All Teachers</h2>
    <a class="button" href="/teachers/new">Add Teacher</a>
</div>

<table>
    <tr>
        <th>ID</th>
        <th>Registration Number</th>
        <th>First Name</th>
        <th>Last Name</th>
        <th>Action</th>
    </tr>

    <% teachers.forEach(teacher => { %>
        <tr>
            <td><%= teacher.id %></td>
            <td><%= teacher.registration_number %></td>
            <td><%= teacher.first_name %></td>
            <td><%= teacher.last_name %></td>
            <td>
                <a href="/teachers/<%= teacher.id %>">Show</a> |
                <a href="/teachers/<%= teacher.id %>/edit">Edit</a> |
                <a href="/teachers/<%= teacher.id %>/delete">Delete</a>
            </td>
        </tr>
    <% }) %>
</table>
