<div class="mx-auto max-w-3xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-gray-200 sm:p-8">
    <div class="mb-6">
      <h2 class="text-2xl font-bold text-gray-900">Update a DS Division</h2>
      <p class="mt-1 text-sm text-gray-600">Update the DS division details below.</p>
    </div>

    <form action="/dsdivisions/<%= dsdivision.id %>" method="POST" class="space-y-6">
      <div>
        <label for="district_id" class="block text-sm font-medium text-gray-900">District ID</label>
        <div class="mt-2">
          <input
            id="district_id"
            type="text"
            name="district_id"
            value="<%= dsdivision.district_id %>"
            class="block w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500"
          />
        </div>
      </div>

      <div>
        <label for="code" class="block text-sm font-medium text-gray-900">Code</label>
        <div class="mt-2">
          <input
            id="code"
            type="text"
            name="code"
            value="<%= dsdivision.code %>"
            class="block w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500"
          />
        </div>
      </div>

      <div>
        <label for="name" class="block text-sm font-medium text-gray-900">Name</label>
        <div class="mt-2">
          <input
            id="name"
            type="text"
            name="name"
            value="<%= dsdivision.name %>"
            required
            class="block w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500"
          />
        </div>
      </div>
      <div class="flex justify-end gap-4 pt-4">
        <a
          href="/dsdivisions"
          class="inline-flex items-center justify-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-sm transition hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2"
        >
          Cancel
        </a>
        <button
          type="submit"
          class="inline-flex items-center justify-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2"
        >
          Save
        </button>
      </div>
    </form>
  </div>
</div>