<div class="max-w-2xl mx-auto py-10">
  <h2 class="text-2xl font-semibold text-slate-800 mb-4">Edit DS Division</h2>

  <form action="/api/dsdivisions/<%= dsdivision.id %>" method="POST" class="space-y-4 bg-white p-6 rounded-lg border border-slate-200">
    <div>
      <label class="block text-sm font-medium text-slate-700">Name</label>
      <input type="text" name="name" required value="<%= dsdivision.name || dsdivision.ds_name %>" class="mt-1 block w-full rounded-md border-slate-200 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" />
    </div>

    <div>
      <label class="block text-sm font-medium text-slate-700">District ID</label>
      <input type="number" name="district_id" value="<%= dsdivision.district_id %>" class="mt-1 block w-full rounded-md border-slate-200 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" />
    </div>

    <div class="flex items-center gap-3">
      <button type="submit" class="rounded-lg bg-amber-600 px-4 py-2 text-sm font-medium text-white hover:bg-amber-700">Update</button>
      <a href="/api/dsdivisions/<%= dsdivision.id %>" class="rounded-lg bg-slate-200 px-4 py-2 text-sm text-slate-700 hover:bg-slate-300">Cancel</a>
    </div>
  </form>
</div>