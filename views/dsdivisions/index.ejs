

<div class="d-flex justify-content-between align-items-center mb-3">
  <h2>DS Divisions</h2>
  <a href="/dsdivisions/new" class="btn btn-primary">Add DS Division</a>
</div>

<div class="card shadow-sm">
  <div class="card-body">
    <table class="table table-striped mb-0">
      <thead>
        <tr><th>ID</th><th>Name</th><th>Actions</th></tr>
      </thead>
      <tbody>
        <% dsdivisions.forEach((item) => { %>
          <tr>
            <td><%= item.id %></td>
            <td><%= item.name %></td>
            <td>
              <a href="/dsdivisions/<%= item.id %>" class="btn btn-sm btn-info">View</a>
              <a href="/dsdivisions/<%= item.id %>/edit" class="btn btn-sm btn-warning">Edit</a>
              <a href="/dsdivisions/<%= item.id %>/delete" class="btn btn-sm btn-danger">Delete</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
