
<h2>Delete DS Division</h2>

<div class="card shadow-sm p-4">
  <p>Are you sure you want to delete this DS division?</p>
  <p><strong>ID:</strong> <%= dsdivision.id %></p>
  <p><strong>Name:</strong> <%= dsdivision.name %></p>
  <form action="/dsdivisions/<%= dsdivision.id %>/delete" method="POST">
    <button type="submit" class="btn btn-danger">Confirm Delete</button>
    <a href="/dsdivisions" class="btn btn-secondary">Cancel</a>
  </form>
</div>