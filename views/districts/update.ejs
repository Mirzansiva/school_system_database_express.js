<h2>Edit District</h2>

<form action="/districts/<%= district.id %>" method="POST">
    <div>
        <label for="province_id">Province ID</label>
        <input type="text" id="province_id" name="province_id" value="<%= district.province_id %>" required>
    </div>

    <div>
        <label for="code">Code</label>
        <input type="text" id="code" name="code" value="<%= district.code %>" required>
    </div>

    <div>
        <label for="name">Name</label>
        <input type="text" id="name" name="name" value="<%= district.name %>" required>
    </div>

    <button type="submit">Update District</button>
</form>
