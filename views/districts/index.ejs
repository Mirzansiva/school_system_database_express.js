<div class="topbar">
    <h2>All Districts</h2>
    <a class="button" href="/districts/new">Add District</a>
</div>

<table>
    <tr>
        <th>ID</th>
        <th>Province ID</th>
        <th>Code</th>
        <th>Name</th>
        <th>Action</th>
    </tr>

    <% if (districts && districts.length) { %>
        <% districts.forEach(district => { %>
            <tr>
                <td><%= district.id %></td>
                <td><%= district.province_id %></td>
                <td><%= district.code %></td>
                <td><%= district.name %></td>
                <td>
                    <a href="/districts/<%= district.id %>">Show</a>
                    |
                    <a href="/districts/<%= district.id %>/edit">Edit</a>
                    |
                    <a href="/districts/<%= district.id %>/delete">Delete</a>
                </td>
            </tr>
        <% }) %>
    <% } else { %>
        <tr>
            <td colspan="5">No districts found.</td>
        </tr>
    <% } %>
</table>
