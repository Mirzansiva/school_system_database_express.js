<h1>Add New Student</h1>

<form action="/students" method="POST">
    <div>
        <label for="id">Admission Number</label><br>
        <input type="text" id="admission_number" name="admission_number" required>
    </div>

    <div>
        <label for="student_id">Student ID</label><br>
        <input type="text" id="student_id" name="student_id" required>
    </div>

    <div>
        <label for="subject_id">Subject ID</label><br>
        <input type="text" id="subject_id" name="subject_id" required>
    </div>

    <div>
        <label for="exam_id">Subject ID</label><br>
        <input type="text" id="exam_id" name="exam_id" required>
    </div>
 
    <div>
        <label for="marks_obtained">Marks Obtained</label><br>
        <input type="text" id="marks_obtained" name="marks_obtained" required>
    </div>


    <button type="submit">Save marks</button>
</form>



