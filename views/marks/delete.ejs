<style>
    .delete-form {
        display: flex;
        gap: 12px;
        align-items: center;
        margin-top: 16px;
    }

    .delete-form .yes-btn {
        background: #2e8b57;
        color: white;
        padding: 10px 18px;
        border: none;
        border-radius: 8px;
        cursor: pointer;
    }

    .delete-form .no-btn {
        background: #d9534f;
        color: white;
        padding: 10px 18px;
        border: none;
        border-radius: 8px;
        text-decoration: none;
        display: inline-block;
    }
</style>

<h1>Delete marks</h1>

<p><strong>id:</strong>
<%=marks.id %></p>

<p><strong>student_id:</strong>
<%= marks.student_id %></p>

<p><strong>subject_id:</strong>
<%= marks.subject_id %></p>

<hr>

<h3>Do you want to delete this record?</h3>

<form action="/marks/<%= mark.id %>/delete" method="POST" class="delete-form">
    <button type="submit" class="yes-btn">Yes</button>
    <a href="/students" class="no-btn">No</a>
</form>