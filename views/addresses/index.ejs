<div class="topbar">
  <h2>Addresses</h2>
  <a class="button" href="/addresses/new">Add Address</a>
</div>

<table>
  <tr>
    <th>gn_id</th>
    <th>gn_code</th>
    <th>village</th>
    <th>population</th>
    <th>Action</th>
  </tr>

  <% if (addresses && addresses.length) { %>
    <% addresses.forEach(address => { %>
      <tr>
        <td><%= address.gn_id %></td>
        <td><%= address.gn_code %></td>
        <td><%= address.village || '-' %></td>
        <td><%= address.population || '-' %></td>
        <td>
          <a href="/addresses/<%= address.gn_id %>">Show</a>
          |
          <a href="/addresses/<%= address.gn_id %>/edit">Edit</a>
          |
          <a href="/addresses/<%= address.gn_id %>/delete">Delete</a>
        </td>
      </tr>
    <% }) %>
  <% } else { %>
    <tr>
      <td colspan="5">No addresses found.</td>
    </tr>
  <% } %>
</table>