<div class="mx-auto max-w-2xl space-y-4">
  <div class="text-center">
    <h2 class="text-2xl font-semibold text-slate-800">Address Details</h2>
    <p class="text-sm text-slate-500">Detailed information for this address record.</p>
  </div>

  <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <div class="grid gap-4 md:grid-cols-2">
      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-slate-500">ID</p>
        <p class="mt-1 text-base text-slate-700"><%= address.id %></p>
      </div>
      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-slate-500">Village</p>
        <p class="mt-1 text-base text-slate-700"><%= address.village || '-' %></p>
      </div>
      <div class="md:col-span-2">
        <p class="text-sm font-semibold uppercase tracking-wide text-slate-500">Address</p>
        <p class="mt-1 text-base text-slate-700"><%= address.address || '-' %></p>
      </div>
    </div>
  </div>

  <div class="text-center">
    <a href="/api/addresses" class="rounded-lg bg-slate-700 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800">Back</a>
  </div>
</div>