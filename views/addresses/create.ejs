<h2 class="mb-4">Create Address</h2>

<form action="/api/addresses" method="POST">
  <div class="mb-3">
    <label class="form-label">Address</label>
    <input type="text" name="address" class="form-control" required>
  </div>
  <div class="mb-3">
    <label class="form-label">GN Division ID</label>
    <input type="number" name="gn_division_id" class="form-control" required>
  </div>
  <button type="submit" class="btn btn-success">Save Address</button>
  <a href="/api/addresses" class="btn btn-secondary">Cancel</a>
</form>
