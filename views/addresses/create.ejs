<h2>Add New Address</h2>

<form action="/addresses" method="POST">
    <div>
        <label for="gn_code">GN Code</label>
        <input type="text" id="gn_code" name="gn_code" required>
    </div>

    <div>
        <label for="gn_id">GN ID</label>
        <input type="text" id="gn_id" name="gn_id" required>
    </div>

    <button type="submit">Save Address</button>
</form>
