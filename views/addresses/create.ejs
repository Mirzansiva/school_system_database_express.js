<div class="mx-auto max-w-2xl rounded-lg border border-slate-200 bg-white shadow-md">
  <div class="border-b border-slate-200 px-6 py-4">
    <h1 class="text-2xl font-bold text-slate-900">Create Address</h1>
    <p class="mt-1 text-sm text-slate-600">Add a new address to the system</p>
  </div>

  <form action="/addresses" method="POST" class="p-6">
    <div class="space-y-6">
      <!-- GN Code -->
      <div>
        <label for="gn-code" class="block text-sm font-semibold text-slate-900">GN Code</label>
        <input
          id="gn-code"
          type="text"
          name="gn_code"
          autocomplete="off"
          class="mt-2 block w-full rounded-lg border border-slate-300 bg-white px-4 py-2 text-slate-900 placeholder:text-slate-400 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
        />
      </div>

      <!-- Village -->
      <div>
        <label for="village" class="block text-sm font-semibold text-slate-900">Village</label>
        <input
          id="village"
          type="text"
          name="village"
          autocomplete="given-name"
          class="mt-2 block w-full rounded-lg border border-slate-300 bg-white px-4 py-2 text-slate-900 placeholder:text-slate-400 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
        />
      </div>

      <!-- Population -->
      <div>
        <label for="population" class="block text-sm font-semibold text-slate-900">Population</label>
        <input
          id="population"
          type="text"
          name="population"
          autocomplete="family-name"
          class="mt-2 block w-full rounded-lg border border-slate-300 bg-white px-4 py-2 text-slate-900 placeholder:text-slate-400 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
        />
      </div>
    </div>

    <!-- Action Buttons -->
    <div class="mt-8 flex items-center justify-end gap-4">
      <a href="/addresses" class="inline-flex items-center justify-center rounded-lg border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-900 hover:bg-slate-50">
        Cancel
      </a>
      <button
        type="submit"
        class="inline-flex items-center justify-center rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500"
      >
        Save
      </button>
    </div>
  </form>
</div>