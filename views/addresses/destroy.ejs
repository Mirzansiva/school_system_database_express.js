<div class="max-w-2xl mx-auto space-y-6 py-10">
  <div class="text-center">
    <h2 class="text-2xl font-semibold text-slate-800">Delete Address</h2>
    <p class="mt-2 text-sm text-slate-500">Confirm before permanently removing this address from the database.</p>
  </div>

  <div class="rounded-2xl border border-rose-200 bg-white p-6 shadow-sm">
    <div class="grid gap-4 md:grid-cols-2">
      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-slate-500">ID</p>
        <p class="mt-1 text-base text-slate-700"><%= address.id %></p>
      </div>
      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-slate-500">Village</p>
        <p class="mt-1 text-base text-slate-700"><%= address.village || '-' %></p>
      </div>
      <div class="md:col-span-2">
        <p class="text-sm font-semibold uppercase tracking-wide text-slate-500">Address</p>
        <p class="mt-1 text-base text-slate-700"><%= address.address || '-' %></p>
      </div>
    </div>
  </div>

  <div class="flex flex-wrap justify-center gap-3">
    <form action="/api/addresses/<%= address.id %>/delete" method="POST" class="inline">
      <button type="submit" class="rounded-lg bg-rose-600 px-5 py-2 text-sm font-semibold text-white hover:bg-rose-700">Confirm Delete</button>
    </form>
    <a href="/api/addresses/<%= address.id %>" class="rounded-lg bg-slate-700 px-5 py-2 text-sm font-semibold text-white hover:bg-slate-800">Cancel</a>
  </div>
</div>
