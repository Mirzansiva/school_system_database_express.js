<h2 class="mb-4">Edit Address</h2>

<form action="/api/addresses/<%= address.id %>?_method=PUT" method="POST">
  <div class="mb-3">
    <label class="form-label">Address</label>
    <input type="text" name="address" class="form-control" value="<%= address.address %>" required>
  </div>
  <div class="mb-3">
    <label class="form-label">GN Division ID</label>
    <input type="number" name="gn_division_id" class="form-control" value="<%= address.gn_division_id %>" required>
  </div>
  <button type="submit" class="btn btn-success">Update Address</button>
  <a href="/api/addresses" class="btn btn-secondary">Cancel</a>
</form>
