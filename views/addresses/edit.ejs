<h2 class="text-2xl font-semibold mb-4">Edit Address</h2>

<form action="/api/addresses/<%= address.id %>?_method=PUT" method="POST" class="space-y-6">
  <div class="mb-4">
    <label class="block text-sm font-medium text-gray-700 mb-1">Address</label>
    <input type="text" name="address" class="w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" value="<%= address.address %>" required>
  </div>
  <div class="mb-4">
    <label class="block text-sm font-medium text-gray-700 mb-1">GN Division ID</label>
    <input type="number" name="gn_division_id" class="w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" value="<%= address.gn_division_id %>" required>
  </div>
  <div class="flex items-center gap-3">
    <button type="submit" class="inline-flex items-center justify-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">Update Address</button>
    <a href="/api/addresses" class="inline-flex items-center justify-center rounded-md bg-gray-200 px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-300">Cancel</a>
  </div>
</form>

<h2>Edit Address</h2>

<form action="/api/addresses/<%= address.id %>/edit" method="POST">
    <table>
        <tr>
            <td><label>Admission Number</label></td>
            <td><input type="text" name="admission_number" value="<%= address.admission_number %>"></td>
        </tr>
        <tr>
            <td><label>First Name</label></td>
            <td><input type="text" name="first_name" value="<%= address.first_name %>"></td>
        </tr>
        <tr>
            <td><label>Last Name</label></td>
            <td><input type="text" name="last_name" value="<%= address.last_name %>"></td>
        </tr>
    </table>
    <button type="submit">Update</button>
</form>
