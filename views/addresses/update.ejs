<h2>Update Address</h2>
<br>
<form action="/addresses/<%= address.gn_id %>" method="POST">

<!--GN Code-->
<div>
  <label for="gn_code" class="block text-sm font-medium text-gray-900">GN Code</label>

  <div class="mt-2">
    <input
      id="gn_code"
      type="text"
      name="gn_code"
      value="<%= address.gn_code %>"
      class="block w-full rounded-md bg-white px-3 py-2 text-sm text-gray-900 outline outline-1 outline-gray-300 focus:outline-2 focus:outline-indigo-600"
    />
  </div>




<!-- Village -->
<div>
  <label for="village" class="block text-sm font-medium text-gray-900">Village</label>
  

  <div class="mt-2">
    <input
      id="village"
      type="text"
      name="village"
      value="<%= address.village %>"
      required
      class="block w-full rounded-md bg-white px-3 py-2 text-sm text-gray-900 outline outline-1 outline-gray-300 focus:outline-2 focus:outline-indigo-600"
    />
  </div>
</div>


<!-- Population -->
<div>
  <label for="population" class="block text-sm font-medium text-gray-900">
    Population
  </label>

  <div class="mt-2">
    <input
      id="population"
      type="text"
      value="<%= address.population %>"
      name="population"
      required
      class="block w-full rounded-md bg-white px-3 py-2 text-sm text-gray-900 outline outline-1 outline-gray-300 focus:outline-2 focus:outline-indigo-600"
    />
  </div>
</div>


<!-- Buttons -->
<div class="mt-6 flex justify-end gap-3">
  <a href="/addresses" class="btn btn-secondary"><button
    type="button"
    class="rounded-md bg-gray-200 px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-300"
  >
    Cancel
  </button></a>
  <button
    type="submit"
    class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500"
  >
    Save
  </button>
</div>
</form>
