
<h2>Delete House</h2>

<div class="card shadow-sm p-4">
  <p>Are you sure you want to delete this house?</p>
  <p><strong>ID:</strong> <%= house.id %></p>
  <p><strong>House Name:</strong> <%= house.house_name %></p>
  <p><strong>House Color:</strong> <%= house.house_color %></p>
  <form action="/houses/<%= house.id %>/delete" method="POST">
    <button type="submit" class="btn btn-danger">Confirm Delete</button>
    <a href="/houses" class="btn btn-secondary">Cancel</a>
  </form>
</div>