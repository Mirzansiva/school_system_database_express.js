
<h2>Edit House</h2>

<form action="/houses/<%= house.id %>" method="POST" class="card p-4 shadow-sm">
  <div class="mb-3">
    <label class="form-label">House Name</label>
    <input type="text" name="house_name" class="form-control" value="<%= house.house_name %>" required>
  </div>
  <div class="mb-3">
    <label class="form-label">House Color</label>
    <input type="text" name="house_color" class="form-control" value="<%= house.house_color %>" required>
  </div>
  <button type="submit" class="btn btn-success">Update</button>
  <a href="/houses" class="btn btn-secondary">Cancel</a>
</form>
