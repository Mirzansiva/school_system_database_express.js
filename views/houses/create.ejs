
<h2>Add House</h2>

<form action="/houses" method="POST" class="card p-4 shadow-sm">
  <div class="mb-3">
    <label class="form-label">House Name</label>
    <input type="text" name="house_name" class="form-control" required>
  </div>
  <div class="mb-3">
    <label class="form-label">House Color</label>
    <input type="text" name="house_color" class="form-control" required>
  </div>
  <button type="submit" class="btn btn-success">Save</button>
  <a href="/houses" class="btn btn-secondary">Cancel</a>
</form>
