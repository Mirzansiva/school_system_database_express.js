<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Management System</title>
    <link rel="stylesheet" href="/css/output.css">
    <style>
        * {
            box-sizing: border-box;
        }

     

        .layout {
            display: flex;
            align-items: flex-start;
            min-height: calc(100vh - 140px);
        }

        .content {
            flex: 1;
            padding: 30px;
        }

        .content h2 {
            margin-top: 0;
        }

        table.data-table {
            width: 100%;
            border-collapse: collapse;
            background-color: #fff;
            margin-top: 15px;
        }

        table.data-table th,
        table.data-table td {
            border: 1px solid #ddd;
            padding: 10px 14px;
            text-align: left;
        }

        table.data-table th {
            background-color: #4CAF50;
            color: white;
        }

        table.data-table tr:nth-child(even) {
            background-color: #f9f9f9;
        }

        .action-links {
            white-space: nowrap;
        }

        .action-links a {
            margin-right: 8px;
            text-decoration: none;
            color: #2e7d32;
            font-weight: 500;
        }

        .action-links a:hover {
            text-decoration: underline;
        }

        .btn-create {
            display: inline-block;
            margin-bottom: 15px;
            padding: 8px 14px;
            background-color: #4CAF50;
            color: white;
            text-decoration: none;
            border-radius: 4px;
        }

        .btn-create:hover {
            background-color: #43a047;
        }

        form table {
            border-collapse: collapse;
            margin-bottom: 15px;
        }

        form table td {
            padding: 8px;
        }

        form input[type="text"] {
            padding: 6px 8px;
            border: 1px solid #ccc;
            border-radius: 4px;
            width: 250px;
        }

        form button {
            padding: 8px 18px;
            background-color: #4CAF50;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        }

        form button:hover {
            background-color: #43a047;
        }

        .footer {
            background-color: #4CAF50;
            color: white;
            text-align: center;
            padding: 14px;
        }
    </style>
</head>

