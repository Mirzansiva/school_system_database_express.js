<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Student Management System</title>
  <link rel="stylesheet" href="/css/output.css" />
</head>

<body class="bg-slate-50 text-slate-900 min-h-screen antialiased">
  <div class="min-h-screen flex flex-col">
    <header class="bg-white border-b border-slate-200 shadow-sm">
      <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
        <div class="flex items-center gap-3">
          <div class="flex h-10 w-10 items-center justify-center rounded-2xl bg-slate-900 text-white">S</div>
          <div>
            <p class="text-sm font-semibold tracking-tight text-slate-900">School System</p>
            <p class="text-xs text-slate-500">Student database management</p>
          </div>
        </div>
        <nav class="hidden items-center gap-4 text-sm text-slate-600 sm:flex">
          <a href="/" class="hover:text-slate-900">Home</a>
          <a href="/addresses" class="hover:text-slate-900">Addresses</a>
          <a href="/students" class="hover:text-slate-900">Students</a>
          <a href="/exams" class="hover:text-slate-900">Exams</a>
          <a href="/districts" class="hover:text-slate-900">Districts</a>
          <a href="/dsdivisions" class="hover:text-slate-900">DS Divisions</a>
          <a href="/families" class="hover:text-slate-900">Families</a>
          <a href="/gndivisions" class="hover:text-slate-900">GN Divisions</a>
        </nav>
      </div>
    </header>

    <main class="flex-1">
      <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
        <%- body %>
      </div>
    </main>

    <footer class="border-t border-slate-200 bg-white py-4">
      <div class="mx-auto max-w-7xl px-4 text-sm text-slate-500 sm:px-6 lg:px-8">
        © <%= new Date().getFullYear() %> School System. Built with Express and EJS.
      </div>
    </footer>
  </div>
</body>

</html>
