<h2>Delete Grade</h2>

<p><strong>Grade Name:</strong> <%= grade.grade_name %></p>
<p><strong>Grade Group:</strong> <%= grade.grade_group %></p>

<h3>Do you want to delete this record?</h3>

<form action="/grades/<%= grade.id %>/delete" method="POST">
    <button type="submit">Yes</button>
</form>
<p><a href="/grades">No</a></p>