<div class="mx-auto max-w-3xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-gray-200 sm:p-8">
    <div class="mb-6">
      <h2 class="text-2xl font-bold text-gray-900">Update a Grade</h2>
      <p class="mt-1 text-sm text-gray-600">Update the grade details below.</p>
    </div>

    <form action="/grades/<%= grade.id %>" method="POST" class="space-y-6">
      <div>
        <label for="gn_code" class="block text-sm font-medium text-gray-900">Grade Name</label>
        <div class="mt-2">
          <input
            id="grade_name"
            type="text"
            name="grade_name"
            value="<%= grade.grade_name %>"
            class="block w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500"
          />
        </div>
      </div>

      <div>
        <label for="grade_group" class="block text-sm font-medium text-gray-900">Grade Group</label>
        <div class="mt-2">
          <input
            id="grade_group"
            type="text"
            name="grade_group"
            value="<%= grade.grade_group %>"
            required
            class="block w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500"
          />
        </div>
      </div>

      <div>
        <label for="grade_order" class="block text-sm font-medium text-gray-900">Grade Order</label>
        <div class="mt-2">
          <input
            id="grade_order"
            type="text"
            name="grade_order"
            value="<%= grade.grade_order %>"
            required
            class="block w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500"
          />
        </div>
      </div>

            <div>
        <label for="colour" class="block text-sm font-medium text-gray-900">Colour</label>
        <div class="mt-2">
          <input
            id="colour"
            type="text"
            name="colour"
            value="<%= grade.colour %>"
            required
            class="block w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500"
          />
        </div>
      </div>

      <div class="flex justify-end gap-4 pt-4">
        <a
          href="/grades"
          class="inline-flex items-center justify-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-sm transition hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2"
        >
          Cancel
        </a>
        <button
          type="submit"
          class="inline-flex items-center justify-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2"
        >
          Save
        </button>
      </div>
    </form>
  </div>
</div>